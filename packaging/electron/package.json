{
  "name": "national-football-manager",
  "productName": "Сборная Футбольный Менеджер",
  "version": "8.0.0",
  "description": "Сборная: Футбольный Менеджер",
  "author": "DanyaDanileckiy",
  "main": "main.js",
  "scripts": {
    "copy": "node ../copy-web.js app",
    "start": "npm run copy && electron .",
    "dist:win": "npm run copy && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "io.github.danyadanileckiy.nfm",
    "artifactName": "NationalFootballManager-${version}-portable.exe",
    "files": ["main.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "icon": "../icons/icon.ico", "target": "portable" },
    "linux": { "icon": "../icons/icon.png" }
  },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" }
}
